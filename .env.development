# Development environment configuration

# Server
PORT=3001
NODE_ENV=development

# Database
DB_PATH=./data/app.db

# JWT
JWT_SECRET=mock-development-secret-key-not-for-production

# OAuth (Mock)
# 在本地開發中使用 Mock OAuth，無需真實 Google 憑證
OAUTH_PROVIDER=mock

# Feature flags
ENABLE_MOCK_OAUTH=true
ENABLE_LOCAL_SYNC=true
SAVE_DIVINATION_DEFAULT=false
SAVE_NOTES_DEFAULT=true
